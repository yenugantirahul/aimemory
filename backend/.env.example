NODE_ENV=development
PORT=5000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/memorydb

# Public URL of the frontend. Browsers reach the API through the frontend's
# /api proxy, so auth lives on this origin. Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Allowed frontend origin(s), comma-separated
CORS_ORIGIN_URL=http://localhost:3000

GEMINI_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TRIGGER_SECRET_KEY=
